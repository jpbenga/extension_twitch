# Optional shell overrides; no credentials required. Export them before npm run dev.
# SERVER_HOST=127.0.0.1
# SERVER_PORT=4000
# SERVER_ORIGIN=http://127.0.0.1:4000
# PORT=3000
# WEB_HOST=127.0.0.1
# PUBLIC_ORIGIN=http://127.0.0.1:3000
# DATABASE_PATH=/absolute/private/path/sessions.sqlite
# DEV_ALLOWED_ORIGINS=your-cloud-host.example
# npm run dev:lan selects a private network address for iPhone testing.
# Keep the Node port private. Remote access requires protected HTTPS hosting.

# Legacy Studio is OFF by default. Local maintenance on a private backup only:
# LEGACY_STUDIO_ENABLED=1 (ignored in production; not a public product option)

# Twitch Local Test (optional; npm run twitch:local loads .env.twitch.local).
# One-time trusted development certificate: npm run twitch:cert (requires mkcert).
# TWITCH_LOCAL_HOST=localhost
# TWITCH_LOCAL_PORT=8443
# For a separately hosted frontend only: public Extension Client ID (not a secret).
# Enables the exact https://<id>.ext-twitch.tv CORS origin on the public-only gateway.
# TWITCH_EXTENSION_CLIENT_ID=
# No Twitch OAuth token, Extension Secret or stream key is required by this read-only viewer.
