{
  "name": "extension-twitch",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "packages/contracts",
    "packages/engine",
    "packages/games/undercover",
    "packages/games/auctions",
    "packages/games/spy",
    "apps/server",
    "apps/web",
    "apps/twitch"
  ],
  "scripts": {
    "stitch:sync": "tsx scripts/stitch-sync.ts",
    "stitch:sync:blocks-3-4": "tsx scripts/stitch-sync-blocks-3-4.ts",
    "test:home": "node scripts/test-e2e.mjs --config=playwright.home.config.ts",
    "test:players": "node scripts/test-e2e.mjs --config=playwright.players.config.ts",
    "build:packages": "tsc -b packages/contracts packages/engine packages/games/undercover packages/games/auctions packages/games/spy",
    "dev": "npm run build:packages && concurrently --kill-others --names types,server,web \"npm run dev:packages\" \"npm run dev --workspace @extension-twitch/server\" \"npm run dev --workspace @extension-twitch/web\"",
    "dev:packages": "npm run build:packages -- --watch --preserveWatchOutput",
    "build": "npm run build --workspaces --if-present",
    "start": "concurrently --kill-others --names server,web \"npm run start --workspace @extension-twitch/server\" \"npm run start --workspace @extension-twitch/web\"",
    "typecheck": "npm run build:packages && npm run typecheck --workspaces --if-present && tsc -p tsconfig.tools.json",
    "test": "npm run build:packages && vitest run",
    "test:e2e": "node scripts/test-e2e.mjs",
    "check": "npm run format:check && npm run test && npm run typecheck && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:lan": "node scripts/dev-lan.mjs",
    "test:lab": "playwright test --config playwright.lab.config.ts",
    "test:games": "node scripts/test-e2e.mjs --config=playwright.games.config.ts",
    "test:design": "node scripts/test-e2e.mjs --config=playwright.design.config.ts",
    "test:legacy": "node scripts/test-e2e.mjs --config=playwright.legacy.config.ts",
    "test:stream": "node scripts/test-e2e.mjs --config=playwright.stream.config.ts",
    "test:layout": "node scripts/test-e2e.mjs --config=playwright.layout.config.ts",
    "test:ux": "node scripts/test-e2e.mjs --config=playwright.ux.config.ts",
    "test:prepare": "node scripts/test-e2e.mjs --config=playwright.prepare.config.ts",
    "test:consolidation": "node scripts/test-e2e.mjs --config=playwright.consolidation.config.ts",
    "test:motion": "node scripts/test-e2e.mjs --config=playwright.motion.config.ts --project=desktop",
    "twitch:build": "npm run build:packages && node scripts/twitch-build.mjs",
    "twitch:cert": "node scripts/twitch-cert.mjs",
    "twitch:local": "node scripts/twitch-local.mjs",
    "twitch:hosted": "node scripts/twitch-hosted.mjs",
    "twitch:package": "npm run twitch:build && node scripts/twitch-package.mjs",
    "test:twitch": "node scripts/test-e2e.mjs --config=playwright.twitch.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "concurrently": "10.0.6",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "esbuild": "0.28.2"
  },
  "type": "module"
}
