{
  "name": "@extension-twitch/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./sessions": {
      "types": "./dist/sessions.d.ts",
      "import": "./dist/sessions.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./game-definition": {
      "types": "./dist/game-definition.d.ts",
      "import": "./dist/game-definition.js"
    },
    "./creator": {
      "types": "./dist/creator.d.ts",
      "import": "./dist/creator.js"
    },
    "./official-games": {
      "types": "./dist/official-games.d.ts",
      "import": "./dist/official-games.js"
    },
    "./spectators": {
      "types": "./dist/spectators.d.ts",
      "import": "./dist/spectators.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
